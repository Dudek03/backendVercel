generator client {
  provider        = "prisma-client-js"
  output          = "../lib/generated/prisma/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Category {
  code     String    @id
  name     String
  products Product[]
}

model Product {
  id          Int      @id
  code        String   @unique @db.VarChar(10)
  name        String
  description String
  image       String
  price       Int
  amount      Int
  date        DateTime @db.Timestamptz(3)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [code], onDelete: Restrict)
  nameSortKey String   @db.Text

  cartItems  CartItem[]
  orderItems OrderItem[]

  // Rozszerzenie 3: Indeks
  @@index([categoryId, amount])
}

// Rozszerzenie 1: Model Koszyka i Użytkownika
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart   Cart?
  orders Order[]
}

model Cart {
  id     String     @id @default(uuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int

  @@unique([cartId, productId])
}

// Rozszerzenie 2: Historia zamówień
model Order {
  id        String      @id @default(uuid())
  number    String      @unique
  status    String
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items     OrderItem[]
  createdAt DateTime    @default(now())
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  productCode String
  quantity    Int
  unitPrice   Int
}
