# Połączenie z bazą danych PostgreSQL (Lab 08 & Lab 09)
DATABASE_URL="postgresql://root:rootpassword@localhost:5432/computershop?schema=public"

# Bazowy URL aplikacji (lokalnie http://localhost:3000)
BETTER_AUTH_URL="http://localhost:3000"

# Losowy sekret Better Auth (co najmniej 32 znaki o wysokiej entropii)
BETTER_AUTH_SECRET="twoj_tajny_losowy_sekret_o_dlugosci_minimum_32_znakow"

# Poświadczenia aplikacji GitHub OAuth App (zarejestrowana na github.com/settings/developers)
GITHUB_CLIENT_ID="twoj_github_client_id"
GITHUB_CLIENT_SECRET="twoj_github_client_secret"
