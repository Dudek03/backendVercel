# ==============================================================================
# Środowisko Lab 10: Wdrożenie i utrzymanie aplikacji (Vercel + Zdalny PostgreSQL)
# Żadna z poniższych zmiennych NIE może posiadać prefiksu NEXT_PUBLIC_!
# ==============================================================================

# Połączenie ze zdalnym PostgreSQL (np. Neon, Supabase, Render, Aiven) z obsługą TLS/SSL
# Przykład zdalny: "postgresql://user:password@ep-cool-fog-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Przykład lokalny: "postgresql://root:rootpassword@localhost:5432/computershop?schema=public"
DATABASE_URL="postgresql://root:rootpassword@localhost:5432/computershop?schema=public"

# Stały adres bazowy aplikacji (Production: https://twoja-aplikacja.vercel.app, Local: http://localhost:3000)
BETTER_AUTH_URL="https://twoja-aplikacja.vercel.app"

# Odrębny, losowy sekret środowiska (co najmniej 32 znaki o wysokiej entropii, np. z openssl rand -base64 32)
BETTER_AUTH_SECRET="losowy_sekret_srodowiska_minimum_32_znaki_o_wysokiej_entropii"

# Dane produkcyjnej aplikacji GitHub OAuth App (zarejestrowana na github.com/settings/developers)
# Authorization callback URL: https://twoja-aplikacja.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID="twoj_produkcyjny_github_client_id"
GITHUB_CLIENT_SECRET="twoj_produkcyjny_github_client_secret"
